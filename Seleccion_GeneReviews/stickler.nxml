                <td headers="hd_h_stickler.T.genes_of_interest_in_the_diff_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">AD<break/>AR<break/>XL&#x000a0;<sup>1</sup></td>
                <td headers="hd_h_stickler.T.genes_of_interest_in_the_diff_1_1_1_4" valign="middle" align="left" rowspan="1" colspan="1">Refractive error &#x02265; &#x02212;6 diopters</td>
              </tr>
              <tr>
                <td headers="hd_h_stickler.T.genes_of_interest_in_the_diff_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">ATOH7</italic>
</td>
                <td headers="hd_h_stickler.T.genes_of_interest_in_the_diff_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">Nonsyndromic congenital retinal nonattachment (NCRNA) (OMIM <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.omim.org/entry/221900">221900</ext-link>)</td>
