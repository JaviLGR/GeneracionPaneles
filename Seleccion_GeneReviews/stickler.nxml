                  <th headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2" id="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_3" valign="middle" align="left" scope="col" rowspan="1" colspan="1"><italic toggle="yes">COL11A2</italic>-SS</th>
                  <th headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2" id="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_4" valign="top" align="left" scope="col" rowspan="1" colspan="1"><italic toggle="yes">COL9A1</italic>-, <italic toggle="yes">COL9A2</italic>-, &#x00026;<break/><italic toggle="yes">COL9A3</italic>-SS</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<bold>Cleft palate</bold>
</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_1" valign="middle" align="left" rowspan="1" colspan="1">30%-60%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_2" valign="middle" align="left" rowspan="1" colspan="1">60%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_3" valign="middle" align="left" rowspan="1" colspan="1">35%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_4" valign="middle" align="left" rowspan="1" colspan="1">--</td>
                </tr>
                <tr>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<bold>Myopia</bold>
</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_1" valign="middle" align="left" rowspan="1" colspan="1">80%-90%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_2" valign="middle" align="left" rowspan="1" colspan="1">80%-85%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_3" valign="middle" align="left" rowspan="1" colspan="1">--</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_4" valign="middle" align="left" rowspan="1" colspan="1">90%-95%</td>
                </tr>
                <tr>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<bold>Retinal detachment</bold>
</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_1" valign="middle" align="left" rowspan="1" colspan="1">40%-70%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_2" valign="middle" align="left" rowspan="1" colspan="1">&#x0003c;40%</td>
                  <td headers="hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_1_2 hd_h_stickler.T.stickler_syndrome_frequency_o_1_1_2_3" valign="middle" align="left" rowspan="1" colspan="1">--</td>
