                </tr>
                <tr>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">GLB1</italic>
</td>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">GM1 gangliosidosis (See <related-object link-type="booklink" source-id="gene" document-id="gm1-ganglio" document-type="book-part"><italic toggle="yes">GLB1</italic>-Related Disorders</related-object>.)</td>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_3" rowspan="2" valign="middle" align="left" colspan="1">Hepatosplenomegaly, hydrops fetalis</td>
                </tr>
                <tr>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">GUSB</italic>
</td>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<related-object link-type="booklink" source-id="gene" document-id="mps7" document-type="book-part">MPS VII</related-object>
</td>
                </tr>
                <tr>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">IDS</italic>
</td>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<related-object link-type="booklink" source-id="gene" document-id="hunter" document-type="book-part">MPS II</related-object>
</td>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_3" rowspan="2" valign="middle" align="left" colspan="1">Hepatosplenomegaly</td>
                </tr>
                <tr>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">IDUA</italic>
</td>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<related-object link-type="booklink" source-id="gene" document-id="mps1" document-type="book-part">MPS I</related-object>
</td>
                </tr>
                <tr>
                  <td headers="hd_h_gaucher.T.genes_of_interest_in_the_diffe_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
