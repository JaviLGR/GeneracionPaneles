                  <td headers="hd_h_cf.T.notable_cftr_variants_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">p.Ala455Glu</td>
                </tr>
                <tr>
                  <td headers="hd_h_cf.T.notable_cftr_variants_1_1_1_2" valign="middle" colspan="1" align="left" scope="row" rowspan="1">c.1521_1523delCTT</td>
