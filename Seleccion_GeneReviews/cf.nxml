                  <td headers="hd_h_cf.T.cystic_fibrosis_frequency_of_select_1_1_1_1" valign="middle" align="left" style="background-color:rgb(255,255,255)" scope="row" rowspan="1" colspan="1">
<bold>Pancreatitis</bold>
</td>
                  <td headers="hd_h_cf.T.cystic_fibrosis_frequency_of_select_1_1_1_2" valign="middle" align="left" style="background-color:rgb(255,255,255)" rowspan="1" colspan="1">~1%</td>
