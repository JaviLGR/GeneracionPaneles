                </tr>
                <tr>
                  <td headers="hd_h_cf.T.notable_cftr_variants_1_1_1_2" valign="middle" colspan="1" align="left" scope="row" rowspan="1">c.1652G&#x0003e;A</td>
                  <td headers="hd_h_cf.T.notable_cftr_variants_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">p.Gly551Asp</td>
                  <td headers="hd_h_cf.T.notable_cftr_variants_1_1_1_4" valign="middle" align="left" rowspan="1" colspan="1">Gating variant responsive to ivacaftor; see <xref ref-type="sec" rid="cf.GenotypePhenotype_Correlations">Genotype-Phenotype Correlations</xref>.</td>
                </tr>
