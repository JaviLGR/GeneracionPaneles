    <body>
      <sec id="lchad.GeneReview_Scope">
        <title><italic toggle="yes">GeneReview</italic> Scope</title>
        <table-wrap id="lchad.T.synonyms_and_included_genes" orientation="portrait" position="anchor">
          <label>Table. </label>
          <caption>
            <p>Synonyms and Included Genes</p>
          </caption>
          <table frame="hsides" rules="groups">
            <thead>
              <tr>
                <th id="hd_h_lchad.T.synonyms_and_included_genes_1_1_1_1" valign="middle" align="left" scope="col" rowspan="1" colspan="1">Disorder</th>
                <th id="hd_h_lchad.T.synonyms_and_included_genes_1_1_1_2" valign="middle" align="left" scope="col" rowspan="1" colspan="1">Synonyms</th>
                <th id="hd_h_lchad.T.synonyms_and_included_genes_1_1_1_3" valign="middle" align="left" scope="col" rowspan="1" colspan="1">Associated Gene(s)</th>
