              <tr>
                <td headers="hd_h_lchad.T.synonyms_and_included_genes_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">Long-chain hydroxyacyl-CoA dehydrogenase (LCHAD) deficiency</td>
                <td headers="hd_h_lchad.T.synonyms_and_included_genes_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1"><list list-type="bullet"><list-item><p>LCHAD deficiency (LCHADD)</p></list-item><list-item><p>Long-chain 3-hydroxyacyl coenzyme A dehydrogenase deficiency</p></list-item></list>
