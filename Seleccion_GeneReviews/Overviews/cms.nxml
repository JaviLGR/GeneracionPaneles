                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">&#x0003c;1%</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">CHRND</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">&#x0003c;1%</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">CHRNE</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">50%</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">COL13A1</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">1%-2%</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">
<xref ref-type="bibr" rid="cms.REF.rodr_guez_cruz.2019.1547">Rodr&#x000ed;guez Cruz et al [2019]</xref>
</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">COLQ</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">10%-15%</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">
<xref ref-type="bibr" rid="cms.REF.mihaylova.2008.747">Mihaylova et al [2008]</xref>
</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">DES</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">Single report</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">
<xref ref-type="bibr" rid="cms.REF.durmu_.2016.799">Durmu&#x0015f; et al [2016]</xref>
</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">DOK7</italic>
</td>
