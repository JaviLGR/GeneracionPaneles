<italic toggle="yes">ALG14</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">&#x0003c;1%</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">
<xref ref-type="bibr" rid="cms.REF.cossins.2013.944">Cossins et al [2013]</xref>
</td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">CHAT</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">4%-5%</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="cms.REF.arican.2018.283">Arican et al [2018]</xref>, <xref ref-type="bibr" rid="cms.REF.mcmacken.2018.194">McMacken et al [2018]</xref></td>
              </tr>
              <tr>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<italic toggle="yes">CHD8</italic>
</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">Single report</td>
