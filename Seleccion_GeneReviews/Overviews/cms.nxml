                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">&#x0003c;1%</td>
                <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_ge_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="cms.REF.cossins.2013.944">Cossins et al [2013]</xref>, <xref ref-type="bibr" rid="cms.REF.monies.2014.353">Monies et al [2014]</xref></td>
