</td>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<italic toggle="yes">RPH3A</italic>
<break/>
<italic toggle="yes">SCN4A</italic>
<break/>
<italic toggle="yes">SLC5A7</italic>
<break/>
<italic toggle="yes">SLC18A3</italic>
</td>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<italic toggle="yes">SLC25A1</italic>
<break/>
<italic toggle="yes">TOR1AIP1</italic>
<break/>
<italic toggle="yes">UNC13A</italic>
<break/>
<italic toggle="yes">VAMP1</italic>
</td>
                </tr>
                <tr>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">
<bold>AD</bold>
</td>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<italic toggle="yes">CHD8</italic>
</td>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<italic toggle="yes">SNAP25</italic>
</td>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1"/>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1"/>
                  <td headers="hd_h_cms.T.congenital_myasthenic_syndromes_mo_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1"/>
