                <td headers="hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_1_1" valign="middle" align="left" scope="row" rowspan="1" colspan="1">Cole disease<break/>(OMIM <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://omim.org/entry/615522">615522</ext-link>)</td>
                <td headers="hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_1_2" valign="middle" align="left" rowspan="1" colspan="1">
<italic toggle="yes">ENPP1</italic>
</td>
                <td headers="hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_1_3" valign="middle" align="left" rowspan="1" colspan="1">AD</td>
                <td headers="hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_1_4 hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_2_1" valign="middle" align="left" rowspan="1" colspan="1">Skin/subcutaneous calcinosis</td>
                <td headers="hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_1_4 hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_2_2 hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_3_1" valign="middle" align="left" rowspan="1" colspan="1">Normal blood phosphorus</td>
                <td headers="hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_1_4 hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_2_2 hd_h_hyper-ftc.T.genetic_disorders_to_conside_1_1_3_2" valign="middle" align="left" rowspan="1" colspan="1"><list list-type="bullet"><list-item><p>Congenital or early-onset punctate keratoderma of palms &#x00026; soles</p></list-item><list-item><p>Diffuse, irregularly shaped hypopigmented skin macules typically over arms &#x00026; legs</p></list-item><list-item><p>May have calcific tendinopathy</p></list-item></list>
</td>
              </tr>
