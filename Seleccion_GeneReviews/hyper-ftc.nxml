                <year>2011</year>
                <article-title>Novel mutations in GALNT3 causing hyperphosphatemic familial tumoral calcinosis.</article-title>
                <source>J Bone Miner Metab</source>
                <volume>29</volume>
                <fpage>621</fpage>
                <lpage>5</lpage>
